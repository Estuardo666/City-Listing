generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model NotificationPreference {
  id         String  @id @default(cuid())
  userId     String  @unique
  // Master switch kept from the original event-reminder feature: false silences
  // every channel and every type, whatever the flags below say.
  enabled    Boolean @default(true)
  hoursAhead Int     @default(48)

  // Channels
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)

  // Types
  eventReminders       Boolean @default(true)
  newFollowedVenuePost Boolean @default(true)
  reviewReply          Boolean @default(true)
  claimUpdates         Boolean @default(true)
  messageReceived      Boolean @default(true)
  moderationUpdates    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventNotification {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// Durable inbox and push outbox for schedule changes. Snapshot the message so
// later edits cannot erase the change a person saved the event before.
model EventUpdateNotice {
  id String @id @default(cuid())
  userId String
  eventId String
  title String
  body String
  slug String
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  leaseUntil DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([deliveredAt, leaseUntil])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Mobile API sessions are intentionally separate from NextAuth web sessions.
// Only a SHA-256 hash of the opaque refresh token is stored.
model MobileRefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Gamificación
  reputationScore   Int @default(0)
  reviewerLevel     Int @default(1)
  totalReviews      Int @default(0)
  totalCheckIns     Int @default(0)
  totalPhotos       Int @default(0)
  totalHelpfulVotes Int @default(0)

  // Onboarding
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  accounts               Account[]
  sessions               Session[]
  mobileRefreshSessions  MobileRefreshSession[]
  events                 Event[]
  venues                 Venue[]
  posts                  Post[]
  notificationPreference NotificationPreference?
  eventNotifications     EventNotification[]
  eventUpdateNotices      EventUpdateNotice[]
  favorites              Favorite[]
  comments               Comment[]
  reviews                Review[]
  venueClaims            VenueClaim[]
  claimedVenues          Venue[]                   @relation("VenueClaimedBy")
  reservations           Reservation[]
  routes                 Route[]
  questions              Question[]
  checkIns               CheckIn[]
  collections            Collection[]
  pushSubscriptions      PushSubscription[]
  deviceTokens           DeviceToken[]
  osmImports             OsmImport[]
  googleImportJobs       GoogleImportJob[]
  badges                 UserBadge[]
  interests              UserInterest[]
  lifestylePreferences   UserLifestylePreference[]
  followingVenues        UserFollowingVenue[]
  onboardingEvents       OnboardingEvent[]

  ticketOrders      TicketOrder[] @relation("TicketOrderBuyer")
  ticketHolds       TicketHold[] @relation("TicketHoldBuyer")
  ticketCheckIns    TicketCheckIn[] @relation("TicketCheckInScanner")
  ticketStaff       EventTicketingStaff[]
  ticketRefunds     TicketRefund[] @relation("TicketRefundProcessor")
  ticketingAudits   TicketingAuditLog[] @relation("TicketingAuditActor")

  businessAccountsOwned  BusinessAccount[] @relation("BusinessAccountOwner")
  businessMemberships    BusinessMembership[]
  billingOrders          Order[] @relation("BillingOrderBuyer")
  addonPurchases         AddonPurchase[]
  billingAuditLogs       BillingAuditLog[] @relation("BillingAuditActor")
  createdPlanVersions    PlanVersion[] @relation("PlanVersionCreator")
  createdVenueOverrides  VenuePlanOverride[] @relation("VenueOverrideCreator")
  updatedBillingSettings BillingSetting[] @relation("BillingSettingUpdater")

  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  quickReplies     QuickReply[]
  blockedUsers     BlockedUser[] @relation("BlockedUsers")
  blockedBy        BlockedUser[] @relation("Blockers")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String
  name        String
  description String
  icon        String?
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  introText      String?
  icon           String?
  color          String?
  type           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subcategories   Subcategory[]
  venueCategories VenueCategory[]
  eventCategories EventCategory[]
  posts           Post[]
  userInterests   UserInterest[]

  @@unique([name, type])
}

model Subcategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  venueSubcategories VenueSubcategory[]
  eventSubcategories EventSubcategory[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model GooglePlaceTypeMapping {
  id               String   @id @default(cuid())
  googleType       String   @unique
  schemaOrgType    String?
  categorySlugs    String[]
  subcategorySlugs String[]
  confidence       Int      @default(100)
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([googleType])
}

model VenueCategory {
  venueId    String
  categoryId String
  createdAt  DateTime @default(now())

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([venueId, categoryId])
  @@index([categoryId])
}

model VenueSubcategory {
  venueId       String
  subcategoryId String
  createdAt     DateTime @default(now())

  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([venueId, subcategoryId])
  @@index([subcategoryId])
}

model EventCategory {
  eventId    String
  categoryId String
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@index([categoryId])
}

model EventSubcategory {
  eventId       String
  subcategoryId String
  createdAt     DateTime @default(now())

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([eventId, subcategoryId])
  @@index([subcategoryId])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String
  content       String?
  image         String?
  startDate     DateTime
  endDate       DateTime?
  price         Float?
  location      String
  lat           Float?
  lng           Float?
  address       String?
  status        String    @default("PENDING")
  featured      Boolean   @default(false)
  sponsoredUntil DateTime?
  isRecurring   Boolean   @default(false)
  parentEventId String?
  avgRating     Float?
  reviewCount   Int       @default(0)
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId            String?
  venue              Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  eventNotifications EventNotification[]
  eventUpdateNotices EventUpdateNotice[]
  favorites          Favorite[]
  comments           Comment[]
  media              Media[]
  reviews            Review[]
  recurrenceRule     RecurrenceRule?
  reservations       Reservation[]
  collections        CollectionItem[]
  questions          Question[]
  eventCategories    EventCategory[]
  eventSubcategories EventSubcategory[]
  billingOrders      Order[]
  addonPurchases     AddonPurchase[]
  ticketingConfig    EventTicketingConfig?
  ticketTypes        TicketType[]
  ticketOrders       TicketOrder[]
  ticketSeatMaps     EventSeatMapVersion[]
  ticketSeats        EventSeat[]
  tickets            Ticket[]
  ticketCheckIns     TicketCheckIn[]
  ticketHolds        TicketHold[]
  ticketStaff        EventTicketingStaff[]
  ticketingAudits    TicketingAuditLog[]

  @@index([status])
  @@index([startDate])
  @@index([venueId])
  @@index([viewCount])
  @@index([sponsoredUntil])
}

model Venue {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String
  content           String?
  image             String?
  logo              String?
  coverImage        String?
  phone             String?
  email             String?
  website           String?
  location          String
  lat               Float?
  lng               Float?
  address           String?
  priceRange        String?
  status            String    @default("PENDING")
  isActive          Boolean   @default(true)
  featured          Boolean   @default(false)
  sponsoredUntil    DateTime?
  claimed           Boolean   @default(false)
  /// Set when a VenueClaim is approved. A real FK so an approved claim cannot
  /// point at a user that no longer exists.
  claimedBy         String?
  verified          Boolean   @default(false)
  badge             String?
  avgRating         Float?
  reviewCount       Int       @default(0)
  viewCount         Int       @default(0)
  googlePlaceId     String?   @unique
  osmId             String?   @unique
  sourceLastSync    DateTime?
  hoursLastSync     DateTime?
  googleRating      Float?
  googleReviewCount Int       @default(0)
  googleLastSyncAt  DateTime?
  reputationScore   Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Owner recorded when a VenueClaim is approved. Kept separate from `user`,
  /// which is whoever created the listing.
  claimedByUser       User?                @relation("VenueClaimedBy", fields: [claimedBy], references: [id], onDelete: SetNull)
  events              Event[]
  favorites           Favorite[]
  comments            Comment[]
  media               Media[]
  reviews             Review[]
  operatingHours      OperatingHours?
  specialHours        SpecialHours[]
  promotions          Promotion[]
  reservations        Reservation[]
  reservationSettings ReservationSettings?
  venueClaims         VenueClaim[]
  routeStops          RouteStop[]
  questions           Question[]
  checkIns            CheckIn[]
  menuCategories      MenuCategory[]
  products            Product[]
  collections         CollectionItem[]
  businessHours       VenueBusinessHours[]
  services            VenueService[]
  venueCategories     VenueCategory[]
  venueSubcategories  VenueSubcategory[]
  watchEventVenues    WatchEventVenue[]
  followingUsers      UserFollowingVenue[]

  businessAccountId String?
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  planOverrides     VenuePlanOverride[]
  orders            Order[]
  billingAuditLogs  BillingAuditLog[]
  addonPurchases    AddonPurchase[]
  googlePlaceUsage  GooglePlaceUsage[]

  parentId String?
  parent   Venue?  @relation("VenueBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches Venue[] @relation("VenueBranches")

  messages      Message[]
  quickReplies  QuickReply[]
  blockedUsers  BlockedUser[]
  branchReviews Review[]      @relation("BranchReviews")

  @@index([status])
  @@index([isActive])
  @@index([sponsoredUntil])
  @@index([googlePlaceId])
  @@index([osmId])
  @@index([avgRating])
  @@index([viewCount])
  @@index([parentId])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  image       String?
  status      String    @default("PENDING")
  featured    Boolean   @default(false)
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  favorites   Favorite[]
  comments    Comment[]
  tags        PostTag[]
  media       Media[]
  collections CollectionItem[]

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts PostTag[]

  @@index([slug])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  eventId      String?
  venueId      String?
  postId       String?
  routeId      String?
  /// Lets a user save someone else's public collection.
  collectionId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  route      Route?      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([userId, venueId])
  @@unique([userId, postId])
  @@unique([userId, routeId])
  @@unique([userId, collectionId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  parentId  String?
  eventId   String?
  venueId   String?
  postId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  event   Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue   Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  post    Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([eventId])
  @@index([venueId])
  @@index([postId])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  type      String   @default("IMAGE")
  order     Int      @default(0)
  venueId   String?
  eventId   String?
  postId    String?
  createdAt DateTime @default(now())

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([eventId])
  @@index([postId])
}

model OperatingHours {
  id        String   @id @default(cuid())
  venueId   String   @unique
  mon       String?
  tue       String?
  wed       String?
  thu       String?
  fri       String?
  sat       String?
  sun       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Review {
  id            String    @id @default(cuid())
  rating        Int
  title         String?
  content       String?
  ownerReply    String?
  ownerReplyAt  DateTime?
  userId        String
  venueId       String?
  eventId       String?
  branchId      String?
  status        String    @default("APPROVED")
  flaggedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue  Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event  Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branch Venue?        @relation("BranchReviews", fields: [branchId], references: [id], onDelete: SetNull)
  photos ReviewPhoto[]

  @@unique([userId, venueId])
  @@unique([userId, eventId])
  @@index([userId])
  @@index([venueId])
  @@index([eventId])
  @@index([rating])
  @@index([status])
  @@index([branchId])
}

model VenueClaim {
  id      String @id @default(cuid())
  venueId String
  userId  String
  status  String @default("PENDING") // PENDING | VERIFIED | APPROVED | REJECTED

  // Claimer info (snapshot del formulario)
  claimerName  String
  claimerEmail String
  claimerPhone String?
  claimerRole  String? // Cargo

  // Verification
  verificationCode String?
  codeExpiresAt    DateTime?
  attempts         Int       @default(0)
  verified         Boolean   @default(false)

  // Evidence
  evidenceUrl  String? // S3 URL
  evidenceName String? // Nombre original del archivo

  // Trust score
  confidenceScore Int @default(0) // 0-100

  // Legacy / admin
  proof      String?
  message    String?
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([userId])
  @@index([status])
  @@index([claimerEmail])
  @@index([verified])

  selectedPlanVersionId String?
  planSelectionStatus  String? // NONE | PENDING_CLAIM_APPROVAL | VOIDED | ACTIVATED | INHERITED_EXISTING
  selectedPlanVersion  PlanVersion? @relation(fields: [selectedPlanVersionId], references: [id], onDelete: SetNull)
  billingOrder         Order?
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  discount    String?
  validFrom   DateTime
  validUntil  DateTime
  terms       String?
  status      String   @default("PENDING")
  featured    Boolean  @default(false)
  venueId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([status])
  @@index([validFrom])
  @@index([validUntil])
}

model Reservation {
  id           String   @id @default(cuid())
  venueId      String?
  eventId      String?
  userId       String
  date         DateTime
  time         String
  partySize    Int
  status       String   @default("PENDING")
  notes        String?
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([eventId])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model ReservationSettings {
  id                  String   @id @default(cuid())
  venueId             String   @unique
  acceptsReservations Boolean  @default(true)
  maxPartySize        Int      @default(20)
  timeSlotDuration    Int      @default(60)
  openingTime         String   @default("09:00")
  closingTime         String   @default("22:00")
  autoConfirm         Boolean  @default(false)
  cancelBeforeHours   Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model RecurrenceRule {
  id         String    @id @default(cuid())
  frequency  String
  interval   Int       @default(1)
  daysOfWeek String?
  dayOfMonth Int?
  startDate  DateTime
  endDate    DateTime?
  count      Int?
  eventId    String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Route {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  content          String?
  image            String?
  duration         String?
  difficulty       String?
  type             String
  status           String   @default("PENDING")
  featured         Boolean  @default(false)
  /// Number of days the itinerary spans; kept denormalised so listings can
  /// filter without loading every stop.
  days             Int      @default(1)
  distanceMeters   Int?
  estimatedMinutes Int?
  startLat         Float?
  startLng         Float?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       RouteStop[]
  favorites   Favorite[]
  collections CollectionItem[]

  @@index([status])
  @@index([type])
  @@index([userId])
}

model RouteStop {
  id            String  @id @default(cuid())
  routeId       String
  venueId       String?
  /// 1-based day of the itinerary. Single-day routes stay on day 1, which is
  /// what every pre-existing row was backfilled to.
  day           Int     @default(1)
  order         Int
  title         String
  notes         String?
  /// Free text ("2 h"), kept as it was; `startTime` is the machine-readable one.
  duration      String?
  /// "HH:mm" in America/Guayaquil. String rather than DateTime because a stop
  /// is a time of day, not an instant.
  startTime     String?
  /// Copied from the venue when there is one, set by hand for stops that are
  /// just a place on the map (a viewpoint, a trailhead).
  lat           Float?
  lng           Float?
  image         String?
  /// Estimated travel time from the previous stop.
  travelMinutes Int?

  route Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([routeId, day, order])
  @@index([routeId])
  @@index([routeId, day, order])
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  active      Boolean  @default(true)
  token       String   @unique
  confirmed   Boolean  @default(false)
  preferences String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([active])
}

model ReviewPhoto {
