// AI Configuration & Processing
// ──────────────────────────────────────────────

model AIProcessingLog {
  id               String   @id @default(cuid())
  sourceType       String // IMAGE | PDF | TEXT
  sourceUrl        String? // R2 URL of uploaded file
  inputText        String? // raw text input (for TEXT source type)
  extractedData    String? // JSON of extracted event data
  watchEventId     String? // linked watch event (null if not yet confirmed)
  tokensUsed       Int?
  costEstimate     Float? // in USD
  processingTimeMs Int?
  status           String   @default("PENDING") // PENDING | COMPLETED | FAILED | CONFIRMED
  errorMessage     String?
  createdAt        DateTime @default(now())

  watchEvent WatchEvent? @relation(fields: [watchEventId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([watchEventId])
}

/// One row per carousel on the mobile/web home screen. `type` picks the
/// resolver, `params` carries its typed options (validated by
/// `src/schemas/home-section.schema.ts`), so the same type can be instantiated
/// many times — "Comer", "Bares" and "Café" are three `venueList` rows with a
/// different `categorySlug`.
model HomeSection {
  id          String    @id @default(cuid())
  type        String
  title       String
  subtitle    String?
  actionLabel String?
  layout      String    @default("carousel")
  params      Json      @default("{}")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  /// all | ios | web — lets a section ship to the app before the website.
  platform    String    @default("all")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, order])
}

// ──────────────────────────────────────────────
// Event ticketing / payments
// ──────────────────────────────────────────────

/// Public event sales mode. The application treats EXTERNAL as a link-only
/// listing; it never claims or mirrors the external provider's payment state.
model EventTicketingConfig {
  id                    String   @id @default(cuid())
  eventId               String   @unique
  mode                  String   @default("NONE") // NONE | INTERNAL | EXTERNAL
  sellerType            String   @default("ORGANIZER") // PLATFORM | ORGANIZER
  paymentAccountId      String?
  externalUrl           String?
  externalProviderLabel String?
  currency              String   @default("USD")
  feeIncidence          String   @default("NONE") // NONE | BUYER_PAYS | ORGANIZER_ABSORBS
  feePercentBps         Int      @default(0)
  feeFixedCents         Int      @default(0)
  salesStartAt          DateTime?
  salesEndAt            DateTime?
  status                String   @default("DRAFT") // DRAFT | READY | ON_SALE | PAUSED | ENDED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentAccount OrganizerPaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  ticketTypes   TicketType[]
  seatMaps      EventSeatMapVersion[]
  holds         TicketHold[]
  orders        TicketOrder[]

  @@index([mode, status])
  @@index([paymentAccountId])
}

model OrganizerPaymentAccount {
  id                   String   @id @default(cuid())
  businessAccountId    String
  provider             String   @default("PAYPHONE")
  displayName          String?
  merchantReference    String?
  storeId              String
  credentialCiphertext String
  credentialIv         String
  credentialAuthTag    String
  credentialKeyVersion Int      @default(1)
  capabilities         Json?
  status               String   @default("PENDING") // PENDING | ACTIVE | RESTRICTED | DISCONNECTED
  lastVerifiedAt       DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  businessAccount BusinessAccount    @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  events          EventTicketingConfig[]

  @@unique([businessAccountId, provider, storeId])
  @@index([businessAccountId, status])
}

model TicketType {
  id              String   @id @default(cuid())
  eventId         String
  ticketingId     String
  slug            String
  name            String
  description     String?
  kind            String   @default("GENERAL") // GENERAL | NUMBERED | ASSIGNED_SEAT
  priceCents      Int
  capacity        Int?
  heldCount       Int      @default(0)
  soldCount       Int      @default(0)
  minPerOrder     Int      @default(1)
  maxPerOrder     Int      @default(10)
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketing   EventTicketingConfig  @relation(fields: [ticketingId], references: [id], onDelete: Cascade)
  holdItems   TicketHoldItem[]
  orderItems  TicketOrderItem[]
  tickets     Ticket[]
  seats       EventSeat[]

  @@unique([eventId, slug])
  @@index([ticketingId, isActive, sortOrder])
}

model EventSeatMapVersion {
  id          String   @id @default(cuid())
  eventId     String
  ticketingId String
  version     Int      @default(1)
  name        String
  layout      Json
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketing   EventTicketingConfig  @relation(fields: [ticketingId], references: [id], onDelete: Cascade)
  seats       EventSeat[]

  @@unique([eventId, version])
  @@index([ticketingId, status])
}

model EventSeat {
  id            String   @id @default(cuid())
  eventId       String
  seatMapId     String
  ticketTypeId  String?
  seatKey       String
  section       String?
  rowLabel      String?
  seatNumber    String
  x             Float
  y             Float
  status        String   @default("AVAILABLE") // AVAILABLE | HELD | SOLD | BLOCKED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatMap    EventSeatMapVersion  @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  ticketType TicketType?          @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  holdItems  TicketHoldItem[]
  orderItems TicketOrderItem[]
  tickets    Ticket[]

  @@unique([eventId, seatKey])
  @@index([seatMapId, status])
  @@index([ticketTypeId, status])
}

model TicketHold {
  id                String   @id @default(cuid())
  eventId           String
  ticketingId       String
  publicTokenHash   String   @unique
  publicTokenLast4  String
  publicTokenCiphertext String?
  publicTokenIv     String?
  publicTokenAuthTag String?
  publicTokenKeyVersion Int?
  sessionKey        String
  idempotencyKey    String?
  buyerUserId       String?
  expiresAt         DateTime
  status            String   @default("ACTIVE") // ACTIVE | CONVERTED | EXPIRED | RELEASED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketing EventTicketingConfig @relation(fields: [ticketingId], references: [id], onDelete: Cascade)
  buyer     User?                @relation("TicketHoldBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  items     TicketHoldItem[]
  order     TicketOrder?

  @@index([eventId, status, expiresAt])
  @@index([sessionKey, createdAt])
  @@unique([sessionKey, idempotencyKey])
}

model TicketHoldItem {
  id             String   @id @default(cuid())
  holdId         String
  ticketTypeId   String
  eventSeatId    String?
  quantity       Int      @default(1)
  unitPriceCents Int
  createdAt      DateTime @default(now())

  hold       TicketHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  eventSeat  EventSeat? @relation(fields: [eventSeatId], references: [id], onDelete: Restrict)

  @@index([holdId])
  @@index([ticketTypeId])
  @@unique([holdId, eventSeatId])
}

model TicketOrder {
  id                   String   @id @default(cuid())
  eventId              String
  ticketingId          String
  holdId               String   @unique
  buyerUserId          String?
  sellerAccountId      String?
  publicTokenHash      String   @unique
  publicTokenLast4     String
  clientTransactionId  String   @unique
  provider             String   @default("PAYPHONE")
  providerPaymentId    String?
  subtotalCents        Int
  platformFeeCents     Int      @default(0)
  totalCents           Int
  refundedCents        Int      @default(0)
  currency             String   @default("USD")
  buyerName            String
  buyerEmail           String
  buyerPhone           String
  billingDocumentId    String?
  status               String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | FAILED | EXPIRED | REFUND_PENDING | REFUNDED | DISPUTED
  checkoutUrl          String?
  providerStatus       String?
  failureCode          String?
  paidAt               DateTime?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketing      EventTicketingConfig   @relation(fields: [ticketingId], references: [id], onDelete: Restrict)
  hold           TicketHold              @relation(fields: [holdId], references: [id], onDelete: Restrict)
  buyer          User?                   @relation("TicketOrderBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  sellerAccount  BusinessAccount?       @relation("TicketOrderSeller", fields: [sellerAccountId], references: [id], onDelete: SetNull)
  items          TicketOrderItem[]
  payments       TicketPaymentAttempt[]
  tickets        Ticket[]
  refunds        TicketRefund[]
  ticketingAudits TicketingAuditLog[]
  ledgerEntries  TicketingLedgerEntry[]
  outbox         TicketingOutbox[]

  @@index([eventId, status, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([sellerAccountId, status, createdAt])
  @@index([provider, providerPaymentId])
}

model TicketOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  ticketTypeId   String
  eventSeatId    String?
  kindSnapshot   String
  nameSnapshot   String
  seatLabel      String?
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int
  createdAt      DateTime @default(now())

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  eventSeat  EventSeat?  @relation(fields: [eventSeatId], references: [id], onDelete: SetNull)
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model TicketPaymentAttempt {
  id                  String   @id @default(cuid())
  orderId             String
  provider            String
  clientTransactionId String
  providerPaymentId   String?
  status              String   @default("CREATED") // CREATED | REDIRECTED | PROCESSING | SUCCEEDED | FAILED | CANCELLED
  providerStatus      String?
  amountCents         Int
  rawResponse         Json?
  failureCode         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, providerPaymentId])
}

model Ticket {
  id             String   @id @default(cuid())
  orderId        String
  eventId        String
  ticketTypeId   String
  orderItemId    String
  eventSeatId    String?
  code           String   @unique
  qrTokenHash    String   @unique
  qrTokenLast4   String
  qrTokenCiphertext String
  qrTokenIv       String
  qrTokenAuthTag  String
  qrTokenKeyVersion Int     @default(1)
  seatLabel      String?
  status         String   @default("ISSUED") // ISSUED | CHECKED_IN | VOID
  issuedAt       DateTime @default(now())
  checkedInAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order      TicketOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  orderItem  TicketOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  eventSeat  EventSeat?      @relation(fields: [eventSeatId], references: [id], onDelete: SetNull)
  checkIns   TicketCheckIn[]

  @@index([eventId, status])
  @@index([orderId])
}

model TicketCheckIn {
  id            String   @id @default(cuid())
  ticketId     String
  eventId      String
  scannerUserId String
  result        String   // ACCEPTED | ALREADY_USED | VOID | INVALID | WRONG_EVENT
  deviceId      String?
  scannedAt     DateTime @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner User   @relation("TicketCheckInScanner", fields: [scannerUserId], references: [id], onDelete: Restrict)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
}

model TicketRefund {
  id              String   @id @default(cuid())
  orderId         String
  processedById   String?
  amountCents     Int
  reason          String
  provider        String
  providerRef     String?
  status          String   @default("REQUESTED") // REQUESTED | PROCESSING | SUCCEEDED | FAILED
  failureCode     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order       TicketOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  processedBy User?       @relation("TicketRefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model TicketingLedgerEntry {
  id          String   @id @default(cuid())
  orderId     String
  entryType   String   // SALE | PLATFORM_FEE | REFUND | PROVIDER_FEE | ADJUSTMENT
  amountCents Int
  currency    String   @default("USD")
  metadata    Json?
  createdAt   DateTime @default(now())

  order TicketOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([entryType, createdAt])
}

model TicketingOutbox {
  id            String   @id @default(cuid())
  orderId       String?
  kind          String
  dedupeKey     String   @unique
  payload       Json
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([orderId, kind])
}

model EventTicketingStaff {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  permissions String[]
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, eventId])
}

model TicketingAuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  orderId   String?
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  event Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  order TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor User?        @relation("TicketingAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

// ──────────────────────────────────────────────
// Billing beta / planes empresariales
// ──────────────────────────────────────────────

/// Cuenta que agrupa ubicaciones, colaboradores y una suscripción compartida.
/// La relación es opcional durante la migración para mantener compatibilidad
/// con registros históricos que todavía solo conocen `Venue.userId`.
model BusinessAccount {
  id        String   @id @default(cuid())
  name      String?
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User               @relation("BusinessAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships    BusinessMembership[]
  venues         Venue[]
  subscriptions  Subscription[]
  orders         Order[]
  usageCounters  UsageCounter[]
  auditLogs      BillingAuditLog[]
  paymentAccounts OrganizerPaymentAccount[]
  ticketOrders   TicketOrder[] @relation("TicketOrderSeller")

  @@index([ownerId])
}

model BusinessMembership {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  role      String   @default("OWNER") // OWNER | ADMIN | EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
}

model Plan {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  isPublished  Boolean       @default(false)
  isArchived   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  versions PlanVersion[]

  @@index([isPublished, isArchived, displayOrder])
}

/// Snapshot inmutable de precios y capacidades. Una versión nunca se edita;
/// se publica otra para que las renovaciones puedan aplicar la política fijada.
model PlanVersion {
  id                  String   @id @default(cuid())
  planId              String
  version             Int
  monthlyPrice        Float    @default(0)
  annualPrice         Float    @default(0)
  currency            String   @default("USD")
  maxLocations        Int?
  maxMembers          Int?
  maxMediaPerVenue    Int?
  googlePhotoEnabled  Boolean  @default(true)
  menuEnabled         Boolean  @default(false)
  servicesEnabled     Boolean  @default(true)
  monthlyEventsPerVenue Int?
  maxActivePromotionsPerVenue Int?
  analyticsRetentionDays Int?
  whatsappEnabled     Boolean  @default(false)
  messagingEnabled    Boolean  @default(false)
  reservationsEnabled Boolean  @default(false)
  priorityModeration  Boolean  @default(false)
  includedBoostCredits Int      @default(0)
  eventTicketingEnabled Boolean @default(false)
  seatMapsEnabled       Boolean @default(false)
  isPublished         Boolean  @default(false)
  publishedAt         DateTime?
  createdById         String?
  createdAt           DateTime @default(now())

  plan              Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy         User?                @relation("PlanVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subscriptions     Subscription[]
  venueOverrides    VenuePlanOverride[]
  orders            Order[]
  selectedByClaims  VenueClaim[]

  @@unique([planId, version])
  @@index([planId, isPublished])
}

model Subscription {
  id                  String   @id @default(cuid())
  accountId           String
  planVersionId       String
  status              String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  cycle               String   @default("MONTHLY") // MONTHLY | ANNUAL | CUSTOM
  startsAt            DateTime
  endsAt              DateTime
  renewsAutomatically Boolean  @default(false)
  referencePrice      Float    @default(0)
  mode                String   @default("SIMULATED")
  source              String   @default("CHECKOUT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account    BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planVersion PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([accountId, status, endsAt])
  @@index([planVersionId])
}

model VenuePlanOverride {
  id            String   @id @default(cuid())
  venueId       String
  planVersionId String
  createdById   String
  reason        String
  startsAt      DateTime @default(now())
  endsAt        DateTime?
  status        String   @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  revokedAt     DateTime?
  revokedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("VenueOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([venueId, status, startsAt, endsAt])
  @@index([planVersionId])
}

model AddonProduct {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  type           String   @default("DIGITAL") // DIGITAL | DELIVERY
  price          Float
  currency       String   @default("USD")
  durationDays   Int?
  requiresDelivery Boolean @default(false)
  isPublished    Boolean  @default(false)
  isArchived     Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
  addonPurchases AddonPurchase[]

  @@index([isPublished, isArchived, displayOrder])
}

model Order {
  id               String   @id @default(cuid())
  accountId        String
  buyerId          String
  venueId          String?
  eventId          String?
  claimId          String?  @unique
  planVersionId    String?
  addonProductId   String?
  idempotencyKey   String?
  kind             String   @default("SUBSCRIPTION") // SUBSCRIPTION | ADDON
  status           String   @default("COMPLETED") // PENDING | COMPLETED | VOIDED | FAILED
  mode             String   @default("SIMULATED")
  cycle            String?  // MONTHLY | ANNUAL
  referenceAmount  Float    @default(0)
  chargedAmount    Float    @default(0)
  currency         String   @default("USD")
  device           String?
  startsAt         DateTime?
  endsAt           DateTime?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account      BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  buyer        User            @relation("BillingOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  venue        Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  claim        VenueClaim?     @relation(fields: [claimId], references: [id], onDelete: SetNull)
  planVersion  PlanVersion?    @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  addonProduct AddonProduct?   @relation(fields: [addonProductId], references: [id], onDelete: SetNull)
  addonPurchase AddonPurchase?

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([buyerId, createdAt])
  @@index([eventId, createdAt])
  @@index([status])
}

model AddonPurchase {
  id             String   @id @default(cuid())
  orderId        String   @unique
  addonProductId String
  buyerId        String
  venueId        String?
  eventId        String?
  deliveryStatus String   @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | IN_PROGRESS | DELIVERED
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addonProduct AddonProduct @relation(fields: [addonProductId], references: [id], onDelete: Restrict)
  buyer        User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  venue        Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([buyerId, createdAt])
  @@index([eventId, createdAt])
  @@index([deliveryStatus])
}

model UsageCounter {
  id          String   @id @default(cuid())
  accountId   String
  venueId     String?
  metric      String   // EVENTS | BOOST_CREDITS | GOOGLE_REQUESTS
  value       Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, venueId, metric, periodStart])
  @@index([accountId, metric, periodStart])
  @@index([venueId, metric, periodStart])
}

model BillingAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  accountId String?
  venueId   String?
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor   User            @relation("BillingAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  account BusinessAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  venue   Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([venueId, createdAt])
  @@index([actorId, createdAt])
}

model GooglePlaceUsage {
  id          String   @id @default(cuid())
  bucket      String   // DAILY | MONTHLY
  periodStart DateTime
  endpoint    String
  venueKey    String   @default("global")
  venueId     String?
  requests    Int      @default(0)
  successes   Int      @default(0)
  errors      Int      @default(0)
  quotaErrors Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([bucket, periodStart, endpoint, venueKey])
  @@index([bucket, periodStart])
  @@index([venueId, bucket, periodStart])
}

model BillingSetting {
  id                 String   @id @default("global")
  simulationEnabled  Boolean  @default(true)
  googlePhotoEnabled Boolean  @default(true)
  updatedById        String?
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation("BillingSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
