# Public/runtime configuration (never commit real values)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://viveloja.com
NEXT_PUBLIC_APP_URL=https://viveloja.com
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.viveloja.app
# Without APPLE_TEAM_ID the AASA route answers 404 on purpose and Universal
# Links stay disabled; set it once the signing team is known.
APPLE_TEAM_ID=
# Android App Links (assetlinks.json). Comma-separated SHA-256 fingerprints.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# Cache/search
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=

# Maps
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_MAPBOX_DARK_STYLE=

# Media
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional integrations
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
RESEND_API_KEY=
AI_ENCRYPTION_KEY=
# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@viveloja.com

# Apple Push Notification service (.p8 key). APNS_PRIVATE_KEY accepts the PEM
# with escaped newlines, which is how Vercel stores multi-line values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.viveloja.app
APNS_PRIVATE_KEY=

# Shared secret for the scheduled notification drain (Vercel Cron).
CRON_SECRET=
